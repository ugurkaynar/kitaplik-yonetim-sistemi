<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                </div>
                
                <% const kod = typeof statusCode !== 'undefined' ? Number(statusCode) : 404; %>
                <% const aciklama = kod === 403
                    ? 'Bu işlem güvenlik nedeniyle reddedildi'
                    : kod === 500
                        ? 'Beklenmeyen bir sunucu hatası oluştu'
                        : 'Aradığınız sayfa bulunamadı'; %>

                <h1 class="display-1 fw-bold text-danger mb-3"><%= kod %></h1>
                
                <h2 class="mb-4"><%= aciklama %></h2>
                
                <p class="lead text-muted mb-4">
                    <% if (kod === 403) { %>
                        Formun süresi dolmuş olabilir. Sayfayı yenileyip yeniden deneyin.
                    <% } else if (kod === 500) { %>
                        Lütfen kısa bir süre sonra tekrar deneyin.
                    <% } else { %>
                        Üzgünüz, aradığınız sayfa mevcut değil veya taşınmış olabilir.
                    <% } %>
                </p>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <a href="/" class="btn btn-primary btn-lg">
                        <i class="bi bi-house-door"></i> Ana Sayfaya Dön
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Geri Dön
                    </button>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <p class="text-muted">
                Yardıma mı ihtiyacınız var? <a href="/contact">İletişim</a> sayfasından bize ulaşabilirsiniz.
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
